DATABASE_URL=

ENVIRONMENT=
LOG_LEVEL=

# Comma-separated list of origins allowed to make cross-origin requests to
# the backend (the frontend dev server's origin, e.g. http://localhost:3000).
CORS_ALLOWED_ORIGINS=

# Required — signs/verifies access tokens (app/core/security.py). Generate
# with e.g. `openssl rand -hex 32`. Never commit a real value.
SECRET_KEY=

# Optional — defaults are 15 minutes / 30 days if unset.
ACCESS_TOKEN_EXPIRE_MINUTES=
REFRESH_TOKEN_EXPIRE_DAYS=

LLM_API_KEY=
EMBEDDING_API_KEY=
RERANKER_API_KEY=

STORAGE_PROVIDER=

STORAGE_BUCKET=

STT_API_KEY=
TTS_API_KEY=

# Frontend: base URL the browser uses to reach the backend API.
NEXT_PUBLIC_API_URL=