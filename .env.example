DATABASE_URL=

ENVIRONMENT=
LOG_LEVEL=

# Comma-separated list of origins allowed to make cross-origin requests to
# the backend (the frontend dev server's origin, e.g. http://localhost:3000).
CORS_ALLOWED_ORIGINS=

# Required — signs/verifies access tokens (app/core/security.py). Generate
# with e.g. `openssl rand -hex 32`. Never commit a real value.
SECRET_KEY=

# Optional — defaults are 15 minutes / 30 days if unset.
ACCESS_TOKEN_EXPIRE_MINUTES=
REFRESH_TOKEN_EXPIRE_DAYS=

# Cookie configuration (ADR 0005) — deployment-aware; do not weaken for
# convenience. Default (lax, no domain) is correct for same-site
# deployments including local dev. For a genuinely cross-site deployment
# (frontend and backend on different registrable domains), set
# COOKIE_SAMESITE=none — this forces Secure automatically (browsers
# require it) — and set COOKIE_DOMAIN only if frontend/backend share a
# parent domain across subdomains.
COOKIE_SAMESITE=
COOKIE_DOMAIN=
COOKIE_SECURE=

# The frontend's own origin — used to build the password-reset link
# emailed to users. Not the same as NEXT_PUBLIC_API_URL below.
FRONTEND_URL=

# Password recovery email delivery (docs/ARCHITECTURE.md "Provider
# abstractions" — EmailProvider). "console" prints to stdout instead of
# sending (a fallback, not a real send). Local dev uses "smtp" pointed at
# Mailpit (infra/compose/docker-compose.yml, http://localhost:8025 for the
# web UI). Production points this at a real SMTP host/relay — never a
# hardcoded vendor. ENVIRONMENT=production + EMAIL_PROVIDER=console (or
# unset) fails at startup — stdout is captured by log aggregation in real
# deployments, which would leak raw password-reset tokens into logs.
EMAIL_PROVIDER=
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=

# Redis (ADR 0006) — optional: no code path attempts a Redis connection
# yet in this slice (see docs/DECISIONS/0006 "Implementation status").
# Local dev points this at infra/compose/docker-compose.yml's `redis`
# service.
REDIS_URL=
REDIS_SOCKET_TIMEOUT_SECONDS=
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=

# Trusted-proxy IP resolution (ADR 0006 §9a). Empty (the default) means
# X-Forwarded-For/Forwarded are ignored unconditionally and the resolved
# client IP is always the direct TCP peer — the safe default. Set this
# only when this backend genuinely sits behind a reverse proxy/load
# balancer you control, to that proxy's real address range (e.g.
# 127.0.0.1/32 for a same-host reverse proxy). Comma-separated CIDRs.
TRUSTED_PROXY_CIDRS=

LLM_API_KEY=
EMBEDDING_API_KEY=
RERANKER_API_KEY=

STORAGE_PROVIDER=

STORAGE_BUCKET=

STT_API_KEY=
TTS_API_KEY=

# Frontend: base URL the browser uses to reach the backend API.
NEXT_PUBLIC_API_URL=